{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 2785",
    "build": "node scripts/with-app-env.mjs vite build && node scripts/inject-csp-nonce.mjs && npm run db:migrate",
    "start": "node .output/server/index.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/openwa/akg-datetime.test.ts src/lib/openwa/akg-builders.test.ts src/lib/openwa/formatPhone.test.ts src/lib/openwa/sessionLabel.test.ts src/lib/openwa/bubbleThread.test.ts src/lib/openwa/search-highlight.test.ts src/lib/wa-phone.test.ts src/lib/openwa/groupInvite.test.ts src/lib/openwa/addToGroupPlan.test.ts src/lib/openwa/addToGroupRun.test.ts src/lib/openwa/scraperCsv.test.ts src/lib/openwa/uiConnect.test.ts",
