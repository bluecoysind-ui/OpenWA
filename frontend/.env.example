# Browser → OpenWA API (embedded at build time unless the user saves URL/key in the dashboard).
VITE_OPENWA_URL=http://localhost:2785
VITE_OPENWA_APIKEY=your_api_key_here

# Railway / Node server (frontend-only deploy): Nitro must use node-server, not vercel.
# railway.json sets NITRO_PRESET on build; do not run `npm ci` again in buildCommand — Railpack
# already ran `npm install` (see frontend/.npmrc keeps devDependencies for Vite).
#
# Server-side proxy routes (/api/whatsapp, /api/dashboard, …) target this origin:
# WA_GATEWAY_URL=https://your-openwa-api.example.com
#
# OpenWA API must allow this UI origin in CORS_ORIGINS when the browser calls the API directly.
